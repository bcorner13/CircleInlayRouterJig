# -*- coding: utf-8 -*-
"""00-bootstrap_params — create/refresh Params.FCStd for CircleInlayRouterJig.

Idempotent:
  - Opens Params.FCStd if it exists, otherwise creates the Params document.
  - Adds missing VarSet properties with their default value; EXISTING values are
    never overwritten (tuned values survive a re-run).
  - (Re)applies the derived-value expressions every run, so the formulas live
    in exactly one place.
  - Does NOT save. Review in FreeCAD, then save Params.FCStd yourself.

Run only after plan.md is approved. Defaults marked TBD are placeholders.
"""
import os
import FreeCAD as App

PROJECT_DIR = os.path.expanduser(
    "~/Documents/3dPrinting/Commercial License/CircleInlayRouterJig")
PARAMS_PATH = os.path.join(PROJECT_DIR, "Params.FCStd")

# (name, type, group, default, doc)
PARAMS = [
    ("InlayDiameter",         "App::PropertyLength", "Inlay",     150.0,  "Nominal laser-cut disc diameter (size knob)"),
    ("LaserKerf",             "App::PropertyLength", "Inlay",     0.15,   "Diameter lost by the disc to laser kerf; 0 if laser SW compensates [TBD]"),
    ("BushingOD",             "App::PropertyLength", "Tooling",   15.875, "Porter-Cable-style guide bushing outer diameter [TBD]"),
    ("BushingProtrusion",     "App::PropertyLength", "Tooling",   6.0,    "Bushing protrusion below router base [TBD]"),
    ("BitDiameter",           "App::PropertyLength", "Tooling",   3.175,  "Router bit cutting diameter [TBD]"),
    ("InlayFitClearance",     "App::PropertyLength", "Clearance", 0.05,   "Per-side glue gap, disc <-> recess wall"),
    ("TemplateHolePrintComp", "App::PropertyLength", "Clearance", 0.15,   "Per-side FDM undersize compensation for the printed hole"),
    ("BushingFloorGap",       "App::PropertyLength", "Template",  1.5,    "Gap between bushing tip and workpiece"),
    ("RouterBaseDiameter",    "App::PropertyLength", "Tooling",   146.05, "Router sub-base diameter: Milwaukee M18 FUEL 2723-20 template base, 5-3/4in"),
    ("BaseSupportOverlap",    "App::PropertyLength", "Template",  2.0,    "Extra plate beyond the router base's outer edge, with the bushing on the hole wall"),
    ("LeadInChamfer",         "App::PropertyLength", "Template",  0.8,    "Top-edge chamfer on the hole for bushing lead-in"),
    ("AlignNotchWidth",       "App::PropertyLength", "Template",  3.0,    "Width of edge-midpoint alignment notches"),
    ("AlignNotchDepth",       "App::PropertyLength", "Template",  3.0,    "Depth of edge-midpoint alignment notches"),
    # Derived — value is set by expression below
    ("RecessDiameter",        "App::PropertyLength", "Derived",   0.0,    "Routed recess diameter (derived)"),
    ("TemplateHoleDiameter",  "App::PropertyLength", "Derived",   0.0,    "Functional template hole diameter (derived)"),
    ("TemplateHoleModelD",    "App::PropertyLength", "Derived",   0.0,    "Hole as modeled incl. print comp (derived)"),
    ("TemplateMargin",        "App::PropertyLength", "Derived",   0.0,    "Plate material outside the hole, each side (derived)"),
    ("TemplateSide",          "App::PropertyLength", "Derived",   0.0,    "Square plate side (derived)"),
    ("TemplateThick",         "App::PropertyLength", "Derived",   0.0,    "Plate thickness (derived)"),
]

DERIVED = {
    "RecessDiameter":       "InlayDiameter - LaserKerf + 2 * InlayFitClearance",
    "TemplateHoleDiameter": "RecessDiameter + BushingOD - BitDiameter",
    "TemplateHoleModelD":   "TemplateHoleDiameter + 2 * TemplateHolePrintComp",
    "TemplateMargin":       "RouterBaseDiameter / 2 - BushingOD / 2 + BaseSupportOverlap",
    "TemplateSide":         "TemplateHoleDiameter + 2 * TemplateMargin",
    "TemplateThick":        "BushingProtrusion + BushingFloorGap",
}


def get_params_doc():
    for d in App.listDocuments().values():
        if d.Name == "Params" or os.path.abspath(d.FileName or "") == PARAMS_PATH:
            return d
    if os.path.exists(PARAMS_PATH):
        return App.openDocument(PARAMS_PATH)
    return App.newDocument("Params")


doc = get_params_doc()
vs = doc.getObject("VarSet") or doc.addObject("App::VarSet", "VarSet")

added, kept = [], []
for name, ptype, group, default, docstr in PARAMS:
    if name in vs.PropertiesList:
        kept.append(name)
        continue
    vs.addProperty(ptype, name, group, docstr)
    setattr(vs, name, default)
    added.append(name)

for name, expr in DERIVED.items():
    vs.setExpression(name, expr)

doc.recompute()

App.Console.PrintMessage(
    "CIRJ-00: added %d, kept %d existing. Derived: Recess=%.3f Hole=%.3f HoleModel=%.3f "
    "Side=%.3f Thick=%.3f\n" % (
        len(added), len(kept), vs.RecessDiameter.Value, vs.TemplateHoleDiameter.Value,
        vs.TemplateHoleModelD.Value, vs.TemplateSide.Value, vs.TemplateThick.Value))
if vs.TemplateThick.Value <= vs.BushingProtrusion.Value:
    App.Console.PrintError("CIRJ-00: TemplateThick <= BushingProtrusion — bushing will hit workpiece\n")
App.Console.PrintMessage("CIRJ-00: not saved. Save Params.FCStd to %s after review.\n" % PROJECT_DIR)
